<div class=[
    {
        "app-wrapper": !state.applicationTemplate,
        blur: state.activeMobile,
    },
]>
    <if(state.initialized)>
        <if(state.applicationTemplate)>
            <${state.applicationTemplate} ...state.applicationTemplateData/>
        </if>
        <else>
            <agent-portal-template ...input/>
        </else>
    </if>
    <loading-shield shieldId="APP_SHIELD"/>
    <if(state.loading)>
        <div class="app-loading-shield">
            <div class="loading-info">
                <loading-spinner/>
                <span>
                    <translation-string pattern=state.loadingHint/>
                </span>
            </div>
        </div>
    </if>
    <div id="kix-modal-area"/>
    <div id="kix-toast-area" style="z-index: 2020;" class="pe-none"/>
</div>
