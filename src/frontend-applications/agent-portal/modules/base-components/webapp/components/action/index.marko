<button
    type="button"
    class="btn p-0"
    title=state.text
    aria-label=state.text
    on-click("doAction")
    key=state.key
>
    <div
        key=state.key + "-actiondiv"
        class=[
            "action d-flex align-items-center overflow-hidden p-1",
            {
                disabled: !state.canRunAction || state.lockRunAction,
            },
        ]
    >
        <icon icon=state.action.icon/>
        <if(state.displayText && state.action.hasLink)>
            <span class="text text-nowrap ms-2 text-truncate">
                ${state.text}
            </span>
        </if>
        <else-if(state.displayText)>
            <span class="ms-2 text text-nowrap text-truncate">
                ${state.text}
            </span>
        </else-if>
    </div>
</button>
