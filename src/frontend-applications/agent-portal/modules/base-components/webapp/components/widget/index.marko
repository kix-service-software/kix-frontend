<div
    class=component.getWidgetClasses()
    data-widgettype=state.widgetType
    data-instanceid=state.instanceId
    data-configurationtype=(
        state.widgetConfiguration ? state.widgetConfiguration.type : ""
    )
    data-widgetid=(
        state.widgetConfiguration ? state.widgetConfiguration.widgetid : ""
    )
    key="widget-" + state.instanceId + state.componentId
    id="widget-" + state.instanceId + state.componentId>
    <div
        class=[
            "widget-header",
            {
                minimizable: state.minimizable,
            },
        ]
        on-click("minimizeWidget", false)
        on-mousedown("headerMousedown", false)>
        <span
            class=[
                "header-left",
                {
                    "gap-2": !input.removeGap,
                },
            ]
            style=[
                input.customGridTemplateColumnsStyle
                    ? input.customGridTemplateColumnsStyle
                    : "",
            ]>
            <div class=[
                "widget-title",
                {
                    "with-icon": input.icon,
                },
            ]>
                <if(input.icon)>
                    <icon
                        icon=input.icon
                        on-click("minimizeWidgetForce")
                        on-mousedown("headerMousedown", true)/>
                </if>
                <h2
                    on-click("minimizeWidgetForce")
                    on-mousedown("headerMousedown", true)
                    class="m-0">
                    <translation-string pattern=state.title/>
                </h2>
            </div>
            <if(input.headercontent)>
                <${input.headercontent}/>
            </if>
            <if(input.headerfilter)>
                <div class="widget-filter" on-click("doNotChangeMinimize")>
                    <${input.headerfilter}/>
                </div>
            </if>
        </span>
        <span class="header-right">
            <action-list
                contextInstanceId=input.contextInstanceId
                list=state.actions
                instanceId=state.instanceId
                displayText=component.getWidgetTypeActionDisplaySetting()
                on-actionListClicked("doNotChangeMinimize")/>
            <if(state.minimizable)>
                <span class="minimize-icon-wrapper">
                    <if(state.minimized)>
                        <button
                            class="kix-icon-sort-down as-button"
                            title=state.translations["Translatable#Expand widget"]
                            aria-label=state.translations["Translatable#Expand widget"]
                            on-click("minimizeWidgetForce")>
                        </button>
                    </if>
                    <else>
                        <button
                            class="kix-icon-triangle-up as-button"
                            title=state.translations["Translatable#Collapse widget"]
                            aria-label=state.translations["Translatable#Collapse widget"]
                            on-click("minimizeWidgetForce")>
                            <span class="path1"/>
                            <span class="path2"/>
                        </button>
                    </else>
                </span>
            </if>
            <if(state.closable)>
                <span class="close-icon-wrapper">
                    <button
                        class="kix-icon-close as-button"
                        title=state.translations["Translatable#Close widget"]
                        aria-label=state.translations["Translatable#Close widget"]
                        on-click("closeClicked")>
                    </button>
                </span>
            </if>
        </span>
    </div>
    <if(!state.minimized)>
        <div key="widget-content" class="widget-content">
            <if(
                Array.isArray(input.contentActions) &&
                input.contentActions.length
            )>
                <if(component.isContentWidget())>
                    <div
                        key="content-actions" + Math.random()
                        class="content-actions">
                        <action-list
                            contextInstanceId=input.contextInstanceId
                            list=input.contentActions/>
                    </div>
                </if>
            </if>
            <if(input.content)>
                <${
                    component.isSidebarWidget() ? "div" : null
                } class="scroll-container">
                    <${input.content} key=state.instanceId/>
                </>
            </if>
        </div>
    </if>
</div>
