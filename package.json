{
    "name": "@kix/frontend",
    "version": "18.37.0",
    "description": "KIXng Frontend Server/Webapplication.",
    "config": {
        "bundlefile": "kix-frontend.tar.gz"
    },
    "scripts": {
        "startup-service": "node dist/server/Startup.js",
        "application-prebuild": "rm -rf ./.cache/lasso && node dist/server/ApplicationBuilder.js",
        "start": "node dist/server/index.js",
        "build": "./node_modules/.bin/gulp",
        "lint": "./node_modules/.bin/eslint --quiet --ext .ts ./src/",
        "build-tiptap": "npx browserify src/frontend-applications/agent-portal/modules/tiptap/webapp/static/build-tiptap.js | npx terser -c -m -o src/frontend-applications/agent-portal/modules/tiptap/webapp/static/tiptap.min.js",
        "build-prosemirror": "npx browserify src/frontend-applications/agent-portal/modules/prosemirror/webapp/static/build-prosemirror.js | npx terser -c -m -o src/frontend-applications/agent-portal/modules/prosemirror/webapp/static/prosemirror.min.js",
        "test": "export http_proxy= && export https_proxy= && export NODE_ENV=test && sleep 1 && ./node_modules/.bin/mocha --reporter mocha-multi-reporters --reporter-options configFile=mocha.json --require source-map-support/register --full-trace --no-experimental-strip-types --exit \"./{,!(node_modules)/**/}*.test.ts\"",
        "test-plugin": "export http_proxy= && export https_proxy= && export NODE_ENV=test && sleep 1 && ./node_modules/.bin/mocha --preserve-symlinks --reporter mocha-multi-reporters --reporter-options configFile=mocha.json --require source-map-support/register --full-trace --exit \"src/plugins/${PLUGIN:-KIXPro}/**/*.test.ts\"",
        "bundle": "rm -fv ${npm_package_config_bundlefile} && touch ${npm_package_config_bundlefile} && tar cfz ${npm_package_config_bundlefile} --ignore-failed-read --warning=no-file-changed --exclude-from=.bundleignore --exclude-vcs --exclude=${npm_package_config_bundlefile} ./",
        "bundle-integration": "rm -f kix-frontend-integrationtest.tar.gz && touch kix-frontend-integrationtest.tar.gz && tar cfz kix-frontend-integrationtest.tar.gz --ignore-failed-read --warning=no-file-changed --exclude-from=.bundleignore-integration --exclude-vcs --exclude=kix-frontend-integrationtest.tar.gz ./",
        "extract-translatables": "./extract-translatables.sh",
        "generate-3rd-party-licenses": "./node_modules/license-checker/bin/license-checker --production --out LICENSE-Third-Party --relativeLicensePath",
        "lint-warn": "./node_modules/.bin/eslint -f node_modules/eslint-html-reporter/reporter-team-city.js -o quality/lint.html --ext .ts ./src/ .",
        "typescript-coverage": "./node_modules/.bin/typescript-coverage-report --outputDir ./quality/coverage-ts"
    },
    "repository": {
        "type": "git",
        "url": "http://git.intra.cape-it.de/Softwareentwicklung/KIXng/frontend/app.git"
    },
    "author": "KIX Service Software GmbH",
    "dependencies": {
        "@babel/preset-env": "^7.28.5",
